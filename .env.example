# GEMINI_API_KEY: Optional server fallback Gemini API key.
# Personal users can also manage encrypted BYOK Gemini API keys directly inside the app's API Key Manager.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- OPTIONAL CLOUD BACKGROUND RENDERING (Cloudflare R2 + D1 + Queues + Separate FFmpeg Server) ---
# Leave blank if using Local Browser FFmpeg.wasm Rendering only.
CF_ACCOUNT_ID=""
CF_API_TOKEN=""
CF_D1_DATABASE_ID=""
CF_QUEUE_ID=""

# Private Cloudflare R2 Object Storage (S3-compatible credentials, no public bucket access required)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Optional wake-up webhook URL if your separate FFmpeg Worker Server supports HTTP wake triggers
FFMPEG_WORKER_WAKE_URL=""
FFMPEG_WORKER_SHARED_SECRET=""

